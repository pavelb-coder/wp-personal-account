{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "wppa/login-button",
	"title": "Кнопка входа",
	"category": "widgets",
	"icon": "admin-users",
	"description": "Кнопка входа для посетителей сайта.",
	"keywords": [
		"вход",
		"логин",
		"login"
	],
	"textdomain": "wp-personal-account",
	"attributes": {
		"buttonText": {
			"type": "string",
			"default": ""
		},
		"buttonStyle": {
			"type": "string",
			"default": "primary"
		},
		"buttonSize": {
			"type": "string",
			"default": "md"
		},
		"buttonFullWidth": {
			"type": "boolean",
			"default": false
		},
		"accentColor": {
			"type": "string",
			"default": ""
		},
		"cornerRadius": {
			"type": "number",
			"default": 0
		},
		"buttonBgColor": {
			"type": "string",
			"default": ""
		},
		"buttonTextColor": {
			"type": "string",
			"default": ""
		},
		"buttonBorderColor": {
			"type": "string",
			"default": ""
		},
		"buttonHoverBgColor": {
			"type": "string",
			"default": ""
		},
		"buttonHoverTextColor": {
			"type": "string",
			"default": ""
		},
		"buttonHoverBorderColor": {
			"type": "string",
			"default": ""
		},
		"buttonFontSize": {
			"type": "number",
			"default": 0
		},
		"buttonFontWeight": {
			"type": "string",
			"default": ""
		},
		"buttonBorderWidth": {
			"type": "number",
			"default": -1
		},
		"buttonBorderStyle": {
			"type": "string",
			"default": ""
		},
		"buttonPaddingX": {
			"type": "number",
			"default": -1
		},
		"buttonPaddingY": {
			"type": "number",
			"default": -1
		},
		"buttonRadius": {
			"type": "number",
			"default": -1
		},
		"buttonAlignment": {
			"type": "string",
			"default": ""
		},
		"formUrl": {
			"type": "string",
			"default": ""
		},
		"afterUrl": {
			"type": "string",
			"default": ""
		},
		"openNewTab": {
			"type": "boolean",
			"default": false
		},
		"confirmLogout": {
			"type": "boolean",
			"default": false
		},
		"buttonFontFamily": {
			"type": "string",
			"default": ""
		},
		"buttonItalic": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"align": [
			"wide",
			"full"
		]
	}
}
