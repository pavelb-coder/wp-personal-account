{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wppa/auth",
	"title": "Вход и регистрация (личный кабинет)",
	"category": "widgets",
	"icon": "lock",
	"description": "Форма входа и регистрации плагина WP Personal Account. Работает в блочных темах и в Site Editor.",
	"keywords": [
		"вход",
		"регистрация",
		"логин",
		"личный кабинет",
		"login"
	],
	"textdomain": "wp-personal-account",
	"attributes": {
		"mode": {
			"type": "string",
			"default": "both"
		},
		"redirect": {
			"type": "string",
			"default": ""
		},
		"hideForMembers": {
			"type": "boolean",
			"default": true
		},
		"showTitle": {
			"type": "boolean",
			"default": false
		},
		"title": {
			"type": "string",
			"default": "Личный кабинет"
		},
		"align": {
			"type": "string"
		},
		"appearance": {
			"type": "string",
			"default": "plain"
		},
		"maxWidth": {
			"type": "string",
			"default": "auto"
		},
		"buttonSize": {
			"type": "string",
			"default": "md"
		},
		"buttonFullWidth": {
			"type": "boolean",
			"default": false
		},
		"buttonStyle": {
			"type": "string",
			"default": "primary"
		},
		"accentColor": {
			"type": "string",
			"default": ""
		},
		"cornerRadius": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"color": {
			"background": true,
			"text": true,
			"gradients": true,
			"heading": true,
			"button": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": null
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"fontFamily": false,
			"fontStyle": false,
			"fontWeight": true,
			"letterSpacing": false,
			"textTransform": false
		}
	}
}
