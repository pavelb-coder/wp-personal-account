{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wppa/login",
	"title": "Вход (личный кабинет)",
	"category": "widgets",
	"icon": "admin-users",
	"description": "Форма входа плагина WP Personal Account либо кнопка «Войти». Отдельный блок: можно поставить без формы регистрации.",
	"keywords": [
		"вход",
		"логин",
		"войти",
		"login",
		"личный кабинет"
	],
	"textdomain": "wp-personal-account",
	"attributes": {
		"display": {
			"type": "string",
			"default": "form"
		},
		"buttonText": {
			"type": "string",
			"default": "Войти"
		},
		"mode": {
			"type": "string",
			"default": "login"
		},
		"redirect": {
			"type": "string",
			"default": ""
		},
		"hideForMembers": {
			"type": "boolean",
			"default": true
		},
		"showTitle": {
			"type": "boolean",
			"default": false
		},
		"title": {
			"type": "string",
			"default": "Войти"
		},
		"hideOther": {
			"type": "boolean",
			"default": false
		},
		"align": {
			"type": "string"
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		}
	}
}
