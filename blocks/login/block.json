{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wppa/login",
	"title": "Вход (личный кабинет)",
	"category": "widgets",
	"icon": "admin-users",
	"description": "Форма входа плагина WP Personal Account либо кнопка «Войти». Отдельный блок: можно поставить без формы регистрации.",
	"keywords": [
		"вход",
		"логин",
		"войти",
		"login",
		"личный кабинет"
	],
	"textdomain": "wp-personal-account",
	"attributes": {
		"display": {
			"type": "string",
			"default": "form"
		},
		"buttonText": {
			"type": "string",
			"default": "Войти"
		},
		"mode": {
			"type": "string",
			"default": "login"
		},
		"redirect": {
			"type": "string",
			"default": ""
		},
		"hideForMembers": {
			"type": "boolean",
			"default": true
		},
		"showTitle": {
			"type": "boolean",
			"default": false
		},
		"title": {
			"type": "string",
			"default": "Войти"
		},
		"hideOther": {
			"type": "boolean",
			"default": false
		},
		"align": {
			"type": "string"
		},
		"appearance": {
			"type": "string",
			"default": "plain"
		},
		"maxWidth": {
			"type": "string",
			"default": "auto"
		},
		"buttonSize": {
			"type": "string",
			"default": "md"
		},
		"buttonFullWidth": {
			"type": "boolean",
			"default": false
		},
		"buttonStyle": {
			"type": "string",
			"default": "primary"
		},
		"accentColor": {
			"type": "string",
			"default": ""
		},
		"cornerRadius": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"color": {
			"background": true,
			"text": true,
			"gradients": true,
			"heading": true,
			"button": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": null
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"fontFamily": false,
			"fontStyle": false,
			"fontWeight": true,
			"letterSpacing": false,
			"textTransform": false
		}
	}
}
